{
  "name": "dreams-erp/variant-b-php-mysql",
  "description": "Dreams ERP & CRM Platform - Variant B: PHP + MySQL/MariaDB",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2.0"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php database/migrate.php",
    "seed": "php database/seed.php",
    "test": "php tests/run_tests.php",
    "serve": "php -S 127.0.0.1:8000 -t public"
  }
}
