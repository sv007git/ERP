# Dreams ERP - Variant B Configuration
APP_NAME="Dreams ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=dreams-erp-windows-secret-key-replace-in-production-2026

# Database Driver: 'mysql' or 'sqlite'
DB_CONNECTION=sqlite
DB_FILE=database/dreams_erp.sqlite

# MySQL / MariaDB Settings (Used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dreams_erp
DB_USERNAME=root
DB_PASSWORD=

# Session & Security
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
